# ==============================================================================
# Community Helper - Environment Configuration Template
# ==============================================================================
# Instructions for teammates:
# 1. Duplicate this file and rename it to `.env` inside `backend/`
# 2. Fill in the values below.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=civic-community-helper-secret-key-2026

# 1. Supabase PostgreSQL Connection URL (Port 5432 - IPv4 Session Pooler)
# Format: postgresql://[USER]:[PASSWORD]@[POOLER-HOST]:5432/postgres
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 2. Google Gemini API Key (For full conversational AI demographic extraction)
# Get a free API key at: https://aistudio.google.com/app/apikey
# Note: If omitted, the backend automatically uses its built-in rule-based extractor.
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-flash-lite-latest"

# 3. Brevo (Sendinblue) Transactional Email Service (For OTP Email Verification)
BREVO_API_KEY="your-brevo-api-key"
BREVO_SENDER_EMAIL="your-verified-email@domain.com"
BREVO_SENDER_NAME="CivicHelper AI Portal"
BREVO_SMTP_PORT=2525
