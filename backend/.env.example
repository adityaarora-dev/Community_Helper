# ==============================================================================
# Supabase PostgreSQL Database Configuration
# ==============================================================================
# IMPORTANT FOR TEAMMATES:
# 1. Duplicate this file and rename it to `.env` in the `backend/` directory
# 2. Paste your Supabase IPv4 Session Pooler connection string below.
# 
# Format:
# DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]"
#
# Notice:
# - We strictly use Port 5432 with the Session Pooler hostname (*.pooler.supabase.com)
#   for IPv4 compatibility across mobile Wi-Fi hotspots and home networks.
# ==============================================================================

# Application Port
PORT=5000
NODE_ENV=development

# Remote Supabase IPv4 Session Pooler URL
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
